# ════════════════════════════════════════════════════════════════════
#  EIAMS Production Secrets
#  Copy to /etc/eiams/secrets.env on the server
#  Set permissions: chmod 600 /etc/eiams/secrets.env
#                   chown eiams:eiams /etc/eiams/secrets.env
#
#  NEVER commit secrets.env to git!
#  This file (secrets.env.example) is safe to commit.
# ════════════════════════════════════════════════════════════════════

# ── Django core ──────────────────────────────────────────────────────
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-very-long-random-secret-key-here

# Set to False in production (already handled in settings.py via decouple)
DEBUG=False

# Comma-separated list of allowed hosts
ALLOWED_HOSTS=eiams.yourdomain.com,localhost,127.0.0.1

# ── Database ─────────────────────────────────────────────────────────
# Must match the password set in configuration.nix initialScript
DB_ENGINE=django.db.backends.postgresql
DB_NAME=eiams_db
DB_USER=eiams
DB_PASSWORD=CHANGE_THIS_PASSWORD
DB_HOST=/run/postgresql   # Unix socket path for PostgreSQL
DB_PORT=5432

# ── Email (optional — for password reset, alerts) ────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password
DEFAULT_FROM_EMAIL=EIAMS System <noreply@yourdomain.com>

# ── File storage paths ────────────────────────────────────────────────
STATIC_ROOT=/var/lib/eiams/static
MEDIA_ROOT=/var/lib/eiams/media

# ── Security headers ──────────────────────────────────────────────────
CSRF_TRUSTED_ORIGINS=https://eiams.yourdomain.com
SECURE_HSTS_SECONDS=31536000

# ── Items per page ────────────────────────────────────────────────────
ITEMS_PER_PAGE=10
